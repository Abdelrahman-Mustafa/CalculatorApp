<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorApp.Views.SettingsPage"
             Title="Ayarlar"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <VerticalStackLayout Padding="24" Spacing="20">

        <!-- عنوان القسم -->
        <Label Text="Görünüm"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

        <Label Text="Uygulama Teması"
               FontSize="16"
               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

        <!-- خيارات الراديو لاختيار الثيم -->
        <VerticalStackLayout Spacing="12">
            <RadioButton x:Name="LightRadio"
                         Content="Açık (Light)"
                         CheckedChanged="OnThemeRadioButtonCheckedChanged" />

            <RadioButton x:Name="DarkRadio"
                         Content="Koyu (Dark)"
                         CheckedChanged="OnThemeRadioButtonCheckedChanged" />

            <RadioButton x:Name="SystemRadio"
                         Content="Sistem ayarını kullan (Use system setting)"
                         CheckedChanged="OnThemeRadioButtonCheckedChanged" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>