<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- أحجام الخطوط المشتركة عبر التطبيق -->
    <x:Double x:Key="DisplayFontSize">44</x:Double>
    <x:Double x:Key="ExpressionFontSize">16</x:Double>
    <x:Double x:Key="ButtonFontSize">18</x:Double>
    <x:Double x:Key="SciButtonFontSize">14</x:Double>

    <!-- 1. الـ Style الأساسي المشترك لجميع الأزرار مع مفتاح نصي صريح BaseButtonStyle -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource ButtonFontSize}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OpBtnBgLight}, Dark={StaticResource OpBtnBgDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <!-- 2. النمط الضمني (Implicit Style بدون x:Key) يرث من BaseButtonStyle -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

    <!-- 3. نمط صريح لأزرار العمليات يرث من BaseButtonStyle -->
    <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OpBtnBgLight}, Dark={StaticResource OpBtnBgDark}}" />
    </Style>

    <!-- 4. نمط صريح لأزرار الأرقام يرث من BaseButtonStyle -->
    <Style x:Key="NumberButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NumBtnBgLight}, Dark={StaticResource NumBtnBgDark}}" />
    </Style>

    <!-- 5. نمط صريح لأزرار الدوال العلمية يرث من OperatorButtonStyle -->
    <Style x:Key="SciButtonStyle" TargetType="Button" BasedOn="{StaticResource OperatorButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource SciButtonFontSize}" />
    </Style>

    <!-- 6. نمط صريح لزر التساوي يرث من BaseButtonStyle -->
    <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentBtnBgLight}, Dark={StaticResource AccentBtnBgDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentBtnTextLight}, Dark={StaticResource AccentBtnTextDark}}" />
    </Style>

    <!-- أنماط شاشات العرض -->
    <Style x:Key="DisplayLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="ExpressionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource ExpressionFontSize}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpressionTextLight}, Dark={StaticResource ExpressionTextDark}}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

</ResourceDictionary>