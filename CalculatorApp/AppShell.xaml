<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalculatorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CalculatorApp.Views"
    Title="Hesap Makinesi"
    FlyoutBehavior="Flyout">

    <!-- عنصر القائمة للوضع القياسي -->
    <FlyoutItem Title="Standart">
        <ShellContent ContentTemplate="{DataTemplate views:StandardPage}" Route="StandardPage" />
    </FlyoutItem>

    <!-- عنصر القائمة للوضع العلمي -->
    <FlyoutItem Title="Bilimsel">
        <ShellContent ContentTemplate="{DataTemplate views:ScientificPage}" Route="ScientificPage" />
    </FlyoutItem>

    <!-- عنصر القائمة لصفحة الإعدادات -->
    <FlyoutItem Title="Ayarlar">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

</Shell>